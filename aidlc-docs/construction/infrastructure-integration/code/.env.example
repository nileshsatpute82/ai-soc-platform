# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# PostgreSQL (AWS RDS)
POSTGRES_HOST=your-rds-endpoint.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=security_ops_db
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

# MongoDB (AWS DocumentDB)
DOCDB_HOST=your-docdb-cluster.cluster-xyz.us-east-1.docdb.amazonaws.com
DOCDB_PORT=27017
DOCDB_DATABASE=security_investigations
DOCDB_USER=your_docdb_user
DOCDB_PASSWORD=your_docdb_password

# Redis (AWS ElastiCache)
REDIS_HOST=your-elasticache-cluster.xyz.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_SSL=true

# Circuit Breaker Configuration
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
BEDROCK_BATCH_DELAY=0.1

# Database Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=20
DOCDB_POOL_SIZE=50
DOCDB_TIMEOUT=5000
REDIS_POOL_SIZE=50
REDIS_TIMEOUT=5

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-this